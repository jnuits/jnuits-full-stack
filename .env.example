# =============================================================================
# JnUITS - environment configuration
#
# The authoritative contract is scripts/validate-env.mjs. It runs as `prebuild`
# on EVERY `npm run build`, including on Vercel, in --production mode. If a
# variable below is missing or malformed, the build fails before Next.js
# compiles a single file.
#
# Copy to .env.local for development. Never commit a filled-in copy.
#
# To check a deployed environment against this contract:
#
#   vercel env pull .env.production.local --environment=production
#   node scripts/validate-env.mjs --production
#   rm .env.production.local
#
# The pulled file holds live secrets. Delete it when you are done.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. ALWAYS REQUIRED  (4)  - dev, preview, and production
# -----------------------------------------------------------------------------

# Must be a valid URL. HTTPS is mandatory in production.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Modern publishable key (sb_publishable_...). Do NOT use the legacy anon key;
# support for legacy keys is being retired.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Modern secret key (sb_secret_...). Do NOT use the legacy service_role key.
# Server-only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Canonical public origin. HTTPS is mandatory in production. No trailing slash.
APP_BASE_URL=https://jnuits.org.bd


# -----------------------------------------------------------------------------
# 2. REQUIRED IN PRODUCTION  (18)  - all 22 must be set for a production build
#
# NOTE: prebuild runs --production unconditionally, so a Vercel Preview
# deployment and a local `npm run build` also demand every variable in this
# section. That coupling between build validation and runtime capability is
# tracked in issue #60.
# -----------------------------------------------------------------------------

# --- Auth and abuse protection -----------------------------------------------

# Must be exactly "1", "on", or "true" in production. Anything else fails the
# build. Disable only in non-production, and only when the Supabase Auth
# project also has CAPTCHA disabled, or every sign-in breaks.
AUTH_CAPTCHA_REQUIRED=true

# Cloudflare Turnstile. dash.cloudflare.com -> Turnstile.
# The site key is public by design; the secret key is server-only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Must be exactly "supabase" in production. No other value is accepted.
RATE_LIMIT_BACKEND=supabase

# MINIMUM 32 CHARACTERS. A shorter value fails validation.
# Generate: openssl rand -hex 32
RATE_LIMIT_SECRET_SALT=

# REQUIRED IN PRODUCTION. MINIMUM 32 CHARACTERS. Dedicated HMAC key for app-level MACs
# (step-up cookies, member invitation codes, directory verification).
# Local development may fall back to SUPABASE_SECRET_KEY to support key rotation,
# but production validation requires a dedicated value to decouple the keys.
# Generate: openssl rand -hex 32
APP_MAC_SECRET=

# --- Email delivery (Resend) -------------------------------------------------

RESEND_API_KEY=

# Bare address or display-name form. Both are valid:
#   no-reply@jnuits.org.bd
#   JnUITS <no-reply@jnuits.org.bd>
RESEND_FROM_EMAIL=JnUITS <no-reply@jnuits.org.bd>

# Signs inbound delivery webhooks. The webhook route returns 500 without it.
RESEND_WEBHOOK_SECRET=

# --- Media (Cloudinary) ------------------------------------------------------

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Google Shared Drive exports and retention archives ----------------------

# Must be a syntactically valid email address.
GOOGLE_DRIVE_SERVICE_ACCOUNT_EMAIL=

# Full PEM block. Literal \n escapes are converted to real newlines at runtime,
# so either a single escaped line or a genuine multi-line paste works.
GOOGLE_DRIVE_SERVICE_ACCOUNT_PRIVATE_KEY=

# The exports folder MUST live inside this Shared Drive. Every upload verifies
# containment and is rejected outright if the folder sits elsewhere.
GOOGLE_DRIVE_SHARED_DRIVE_ID=
GOOGLE_DRIVE_EXPORTS_FOLDER_ID=

# Signs retention and event archive manifests. Without it, retention reports
# itself as unconfigured. Generate: openssl rand -hex 32
RETENTION_MANIFEST_SIGNING_SECRET=

# --- Observability -----------------------------------------------------------

# Must be a valid HTTPS URL in production.
NEXT_PUBLIC_SENTRY_DSN=


# -----------------------------------------------------------------------------
# 3. OPTIONAL - not validated, but they change behaviour
# -----------------------------------------------------------------------------

# Server-side Sentry DSN. Falls back to NEXT_PUBLIC_SENTRY_DSN when unset.
SENTRY_DSN=

# Falls back to VERCEL_GIT_COMMIT_SHA. Leave unset on Vercel.
SENTRY_RELEASE=

# Build-time source map upload only. Not needed at runtime.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Reply-to for outbound mail. Falls back to RESEND_FROM_EMAIL.
RESEND_REPLY_TO=

# Signed upload preset, read by the Cloudinary config helper.
CLOUDINARY_UPLOAD_PRESET=

# Browser-side fallback for CLOUDINARY_CLOUD_NAME. Redundant if that is set.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Fallbacks for APP_BASE_URL, checked in this order. Redundant in production,
# where APP_BASE_URL is required anyway.
NEXT_PUBLIC_APP_BASE_URL=
NEXT_PUBLIC_SITE_URL=


# -----------------------------------------------------------------------------
# 4. LOCAL AND CI TOOLING ONLY - do NOT set these on Vercel
# -----------------------------------------------------------------------------

# Supabase CLI auth for the migration parity and cleanup audit scripts.
# SUPABASE_PAT is aliased to SUPABASE_ACCESS_TOKEN by the CLI wrapper.
# Never print either value in a log or report.
SUPABASE_PAT=
SUPABASE_ACCESS_TOKEN=

# Attributed actor for script-persisted operator reports (import, reconcile).
SUPABASE_REPORT_ACTOR_USER_ID=

# Overrides the disposable replay database port when 54322 is unavailable.
# Integers 1024-65535 only. It changes the scratch project alone and never
# touches supabase/config.toml. See docs/operations/migration-bootstrap-and-integrity.md.
SUPABASE_REPLAY_DB_PORT=

# Legacy Strapi/MySQL recovery tooling verifies TLS by default. Point to a
# trusted PEM CA when the retired host uses a private CA. The insecure override
# is emergency-only and must never be set on Vercel.
LEGACY_DATABASE_CA_PATH=
LEGACY_DATABASE_TLS_INSECURE=0


# -----------------------------------------------------------------------------
# 5. NEVER SET THESE - the platform injects them
# -----------------------------------------------------------------------------
#
#   NODE_ENV
#   VERCEL_ENV
#   VERCEL_URL
#   VERCEL_BRANCH_URL
#   VERCEL_PROJECT_PRODUCTION_URL
#   VERCEL_GIT_COMMIT_SHA
#
# Setting them by hand breaks HSTS, the content security policy, CSRF origin
# allow-listing, the Sentry environment tag, and the production lockout on
# /api/debug/sentry.
