NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_REPORT_ACTOR_USER_ID=
SUPABASE_URL=
SUPABASE_PAT=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SERVICE_KEY=
APP_BASE_URL=https://jnuits.org.bd
NEXT_PUBLIC_SITE_URL=https://jnuits.org.bd

# Required for production validation: delivery and private media signing.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_REPLY_TO=
RESEND_WEBHOOK_SECRET=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=

# Required for Google Sheet exports and retention archives.
GOOGLE_DRIVE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_DRIVE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_DRIVE_SHARED_DRIVE_ID=
GOOGLE_DRIVE_EXPORTS_FOLDER_ID=
RETENTION_MANIFEST_SIGNING_SECRET=

# Required for production validation so browser telemetry has a DSN.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_RELEASE=

# Get your site key from dash.cloudflare.com -> Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server-side Turnstile secret key. Never expose this as NEXT_PUBLIC.
TURNSTILE_SECRET_KEY=

# Non-production QA: set false only while the configured Supabase Auth project also has CAPTCHA disabled.
AUTH_CAPTCHA_REQUIRED=true

# Production API abuse protection
RATE_LIMIT_BACKEND=supabase
RATE_LIMIT_SECRET_SALT=
