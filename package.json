{
  "name": "jnuits-full-stack",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": "24.x" },
  "scripts": {
    "dev": "next dev --webpack",
    "dev:turbopack": "next dev --turbopack",
    "prebuild": "node scripts/validate-env.mjs --production",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:node": "vitest run --project node",
    "test:dom": "vitest run --project dom",
    "typecheck": "tsc --noEmit",
    "audit:admin-access": "node scripts/check-admin-access-map.cjs",
    "audit:admin-ui": "node scripts/check-admin-responsive-patterns.cjs",
    "audit:admin-snapshots": "node scripts/capture-admin-snapshots.mjs",
    "audit:portal-snapshots": "node scripts/capture-portal-snapshots.mjs",
    "migration:check": "node scripts/check-migration-parity.cjs",
    "migration:check-order": "node scripts/check-migration-dependencies.mjs",
    "migration:check-order:strict": "node scripts/check-migration-dependencies.mjs --strict",
    "db:replay-bootstrap": "bash supabase/verification/run-bootstrap-replay.sh",
    "certificates:import": "node scripts/import-certificates.mjs",
    "certificates:verify": "node scripts/verify-certificates.mjs",
    "content:import:legacy": "node scripts/import-legacy-public-content.mjs",
    "events:build-seed": "node scripts/build-events-seed.mjs",
    "events:import-fest-2026": "node scripts/import-ai-it-fest-2026-events.mjs",
    "events:import": "node scripts/import-events-seed.mjs",
    "events:verify-concurrency": "node scripts/verify-event-registration-concurrency.mjs",
    "gallery:build-seed": "node scripts/build-gallery-seed.mjs",
    "gallery:import": "node scripts/import-gallery-seed.mjs",
    "gallery:normalize-items": "node scripts/normalize-gallery-items.mjs",
    "committee:import:legacy": "node scripts/import-legacy-committee.mjs",
    "members:onboard": "node scripts/onboard-members.mjs",
    "members:reconcile": "node scripts/reconcile-members.mjs",
    "members:rollover-cycle": "node scripts/rollover-membership-cycle.mjs",
    "rehearse:cutover": "node scripts/rehearse-cutover.mjs",
    "rehearse:cloudinary": "node scripts/validate-cloudinary-assets.mjs",
    "rehearse:rollback": "node scripts/rollback-drill.mjs",
    "rehearse:evidence": "node scripts/build-cutover-evidence-pack.mjs",
    "ops:ensure-super-admin": "node scripts/ensure-super-admin.mjs",
    "ops:relocate-cloudinary": "node scripts/relocate-cloudinary-assets.mjs",
    "ops:verify-sentry": "node scripts/verify-sentry-ingest.mjs",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:auth": "playwright test e2e/authenticated-workflows.spec.ts --project=chromium",
    "test:e2e:ci": "playwright test --project=chromium",
    "test:e2e:install": "playwright install chromium",
    "test:e2e:install:all": "playwright install chromium firefox webkit",
    "test:e2e:matrix": "node scripts/run-playwright-matrix.cjs",
    "test:runtime-probe": "node scripts/runtime-smoke-probe.mjs",
    "db:verify-admin-invite-search": "node scripts/verify-admin-invite-search-migration.cjs",
    "db:verify-committee-onboarding": "vitest run --project node src/lib/committee/onboarding/foundation-migration.test.ts src/lib/committee/onboarding/draft-publish-migration.test.ts",
    "db:audit-cleanup": "node scripts/verify-supabase-cleanup-readiness.cjs",
    "db:types:generate": "bash supabase/verification/run-bootstrap-replay.sh --generate-types"
  },
  "dependencies": {
    "@react-email/components": "1.0.12",
    "@sentry/nextjs": "^10.50.0",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.88.0",
    "csv-parse": "^7.0.2",
    "dotenv": "^17.2.3",
    "lucide-react": "^1.8.0",
    "next": "^16.3.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "read-excel-file": "9.3.10",
    "remark-gfm": "^4.0.1",
    "sanitize-html": "^2.17.5",
    "server-only": "^0.0.1",
    "yet-another-react-lightbox": "^3.31.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.2.4",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.12.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "axe-core": "^4.10.2",
    "eslint": "^9",
    "eslint-config-next": "^16.3.4",
    "jsdom": "^26.1.0",
    "mysql2": "^3.20.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "overrides": { "postcss": "8.5.25" }
}
